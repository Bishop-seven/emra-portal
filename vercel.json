{
  "rewrites": [
    {
      "source": "/api/w/:path*",
      "destination": "https://emra-ai-proxy.emraportal.workers.dev/:path*"
    },
    {
      "source": "/recopilador",
      "destination": "/recopilador.html"
    },
    {
      "source": "/cluster",
      "destination": "/cluster.html"
    },
    {
      "source": "/dato-o-mito",
      "destination": "/dato-o-mito.html"
    },
    {
      "source": "/proyectos-estrategicos",
      "destination": "/proyectos-estrategicos.html"
    },
    {
      "source": "/rutas-gorito",
      "destination": "/rutas-gorito.html"
    },
    {
      "source": "/links",
      "destination": "/links.html"
    },
    {
      "source": "/((?!api/|_vercel/).*)",
      "destination": "/index.html"
    }
  ]
}
