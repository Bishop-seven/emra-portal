{
  "rewrites": [
    {
      "source": "/api/w/:path*",
      "destination": "https://emra-ai-proxy.emraportal.workers.dev/:path*"
    },
    {
      "source": "/recopilador",
      "destination": "/recopilador.html"
    },
    {
      "source": "/cluster",
      "destination": "/cluster.html"
    },
    {
      "source": "/dato-o-mito",
      "destination": "/dato-o-mito.html"
    },
    {
      "source": "/((?!api/|_vercel/).*)",
      "destination": "/index.html"
    }
  ]
}
